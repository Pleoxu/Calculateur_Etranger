  void _tracePrintJsonLine(Map<String, dynamic> payload) {
    if (!_traceEnabled) return;
    try {
      debugPrint(jsonEncode(payload));
    } catch (_) {}
  }

  Map<String, num?> _extractDeltaV0Candidates(dynamic rp) {
    num? read(String fieldName) {
      try {
        final v = (rp as dynamic).deltaV0;
        if (fieldName == 'deltaV0' && v is num) return v;
      } catch (_) {}
      try {
        final v = (rp as dynamic).v0Used;
        if (fieldName == 'v0Used' && v is num) return v;
      } catch (_) {}
      try {
        final v = (rp as dynamic).v0Final;
        if (fieldName == 'v0Final' && v is num) return v;
      } catch (_) {}
      try {
        final v = (rp as dynamic).v0;
        if (fieldName == 'v0' && v is num) return v;
      } catch (_) {}
      return null;
    }

    return {
      'deltaV0': read('deltaV0'),
      'v0Used': read('v0Used'),
      'v0Final': read('v0Final'),
      'v0': read('v0'),
    };
  }

