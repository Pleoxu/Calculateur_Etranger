/// Plage de masse disponible dans le dialogue de tir similaire.
(int, int) similarFireCarreauxRangeFor({
  required Systeme systeme,
  required int currentCarreaux,
}) {
  if (systeme.isCaesarFamily) return (1, 8);
  return (currentCarreaux, currentCarreaux);
}

final porteeMaxSeuilProvider = Provider<double>((ref) {
  final header = ref.watch(tirHeaderProvider);
  final st = ref.watch(tirCompletProvider);

  return getPorteeMaxAbsolueCaesar(
    typeTir: header.typeTir,
    typeChargeCaesar: st.typeChargeCaesar,
  );
});

